index 0000000..f7705d2
--- /dev/null
+++ b/vscode-demo/src/shop/LoyaltyPolicy.java
@@ -0,0 +1,24 @@
+package shop;
+
+public final class LoyaltyPolicy {
+    private LoyaltyPolicy() {
+    }
+
+    public static int pointsFor(double orderTotal) {
+        int earned = (int) Math.floor(orderTotal / 10);
+        if (earned > 50) {
+            earned = 50;
+        }
+        return earned;
+    }
+
+    public static String tierFor(int points) {
+        if (points >= 1000) {
+            return "Gold";
+        }
+        if (points >= 300) {
+            return "Silver";
+        }
+        return "Bronze";
+    }
+}
